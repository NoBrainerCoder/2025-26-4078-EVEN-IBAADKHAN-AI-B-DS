        "# Bubble sort\n",
        "n = int(input(\"enter num of elements:\"))\n",
        "\n",
        "arr = []\n",
        "\n",
        "for i in range(n):\n",
        "    arr.append(input(input(f\"enter element {i+1}:\")))\n",
        "\n",
        "print(\"\\n Original array:\", arr)\n",
        "\n",
        "# Bubble sort logic\n",
        "for i in range(n-1):\n",
        "    for j in range(n-1-i):\n",
        "        if arr[j] > arr[j+1]:\n",
        "            # Swap\n",
        "            arr[j], arr[j+1] = arr[j+1], arr[j]\n",
        "\n",
        "print(\"Sorted array:\", arr)"
